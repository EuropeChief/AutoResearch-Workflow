{
  "schema_version": 3,
  "track": "seed",
  "image": "sha256:REPLACE_WITH_FULL_IMAGE_ID",
  "codex_version": "0.160.0",
  "model_profile": "/YOUR_WORKFLOW/local/model_profiles/seed.toml",
  "candidate": "starter",
  "prompt": "agent_prompt.md",
  "public_files": [
    {
      "source": "public/instruction.md",
      "destination": "instruction.md"
    },
    {
      "source": "public/public_eval",
      "destination": "public_eval"
    }
  ],
  "private_paths": [
    "reference",
    "optimization_evidence"
  ],
  "evaluation": {
    "mode": "worker",
    "command": [
      "/opt/conda/bin/python",
      "/workspace/public_eval/run.py",
      "--candidate",
      "{candidate}",
      "--output",
      "{output}"
    ],
    "timeout_seconds": 7200
  },
  "resources": {
    "cpus": 4,
    "memory": "16g",
    "gpu_ids": [
      "0"
    ]
  },
  "duration": {
    "minimum_seconds": 36000
  },
  "security": {
    "mode": "default"
  }
}
