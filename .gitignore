# Python and local tooling caches
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Local workflow state and generated execution data
.autoresearch-flow/
**/.autoresearch-flow/
pilots/*/build/
pilots/*/runs/
pilots/*/results/
pilots/.release-evidence-*.json
runtime/
runs/
build/
tmp/
*.log
*.sock
*.sqlite
*.sqlite3

# Credentials and local secrets
.env
.env.*
**/auth.json
**/.token_*
**/*credential*.json
**/*secret*.json
**/*token*.json

# Large model/data artifacts and archives
*.ckpt
*.onnx
*.pt
*.pth
*.safetensors
*.tar
*.tar.gz
*.tgz
*.zip
!sources/tutorial/图片和附件/*.zip

# User-maintained configuration and release outputs are not source artifacts.
local/
deliverables/
# Superseded receipts remain locally and in Git history, not in a fresh clone.
release/history/
release/offline_docker_probe.json
release/op*_acceptance_*.json

# Editor/OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.venv/
venv/
